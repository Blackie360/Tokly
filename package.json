{
  "name": "tokly-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:neon": "tsx scripts/migrate-neon.ts",
    "db:migrate:neon:check": "tsx scripts/migrate-neon.ts --check",
    "db:seed": "tsx scripts/seed.ts",
    "db:retention": "tsx scripts/retention.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/postgres.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "better-auth": "latest",
    "drizzle-orm": "latest",
    "next": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "resend": "latest",
    "server-only": "latest",
    "shiki": "^4.4.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
