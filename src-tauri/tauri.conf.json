{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokly",
  "version": "0.1.0",
  "identifier": "com.blackielabs.tokly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tokly",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "backgroundColor": "#171b2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "shortDescription": "Pick up where you left off.",
    "category": "DeveloperTool"
  }
}
