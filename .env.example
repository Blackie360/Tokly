# Application
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://tokly_app:tokly@localhost:5433/tokly
# Production migrations only. Use a direct Neon connection with sslmode=require (no -pooler hostname).
NEON_MIGRATION_DATABASE_URL=

# Optional GitHub sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email
RESEND_API_KEY=
ALERT_FROM_EMAIL=Tokly <alerts@example.com>

# Public ingestion API
INGEST_EVENTS_PER_MINUTE=10000

# Retention job (dry-run unless explicitly confirmed)
RAW_EVENT_RETENTION_DAYS=90
ROLLUP_RETENTION_DAYS=730
RETENTION_CONFIRMED=false
