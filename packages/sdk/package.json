{
  "name": "tokly-sdk",
  "version": "0.1.0",
  "description": "Server-side TypeScript SDK for sending provider-neutral AI usage events to Tokly.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Blackie",
  "homepage": "https://github.com/Blackie360/Tokly#readme",
  "bugs": {
    "url": "https://github.com/Blackie360/Tokly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackie360/Tokly.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ai",
    "observability",
    "tokens",
    "usage",
    "openai",
    "anthropic",
    "vercel-ai-sdk"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
